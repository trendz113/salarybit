{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/tools/debit-card-accident-cover-checker.html",
      "destination": "/tools/accident-cover-checker.html",
      "permanent": true
    }
  ],
  "functions": {
    "api/create-order.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/verify-and-decode.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/create-resume-order.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/rewrite-resume.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
