{
  "version": 2,
  "functions": {
    "api/create-order.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/verify-and-decode.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/create-resume-order.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/rewrite-resume.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
