+# ── SHARED SCAN CACHE (disk-backed, SQLite) ───────────────
+# Replaces the old in-memory dicts. A plain Python dict only lives inside
+# one process's memory — with >1 gunicorn worker (processes), each worker
+# has its own separate copy, so a scan created on worker A is invisible to
+# worker B's payment-verify request (~50% of paying customers hit this).
+# SQLite in WAL mode is safe to share across both multiple processes and
+# multiple threads, so this works regardless of gunicorn worker config.
+_CACHE_DB_PATH = os.path.join(os.environ.get("SCAN_CACHE_DIR", "/tmp"), "scan_cache.db")
+_cache_init_lock = threading.Lock()
+
+
+def _cache_conn():
+    conn = sqlite3.connect(_CACHE_DB_PATH, timeout=10, check_same_thread=False)
+    conn.execute("PRAGMA journal_mode=WAL;")
+    return conn
+
+
+def _cache_init():
+    with _cache_init_lock:
+        conn = _cache_conn()
+        conn.execute("""
+            CREATE TABLE IF NOT EXISTS scan_cache (
+                scan_id   TEXT PRIMARY KEY,
+                namespace TEXT NOT NULL,
+                data      TEXT NOT NULL,
+                ts        REAL NOT NULL
+            )
+        """)
+        conn.commit()
+        conn.close()
+
+
+_cache_init()
+
+
+def _cache_put(namespace, payload, ttl_seconds):
+    _cache_gc(namespace, ttl_seconds)
+    scan_id = uuid.uuid4().hex
+    conn = _cache_conn()
+    conn.execute(
+        "INSERT INTO scan_cache (scan_id, namespace, data, ts) VALUES (?, ?, ?, ?)",
+        (scan_id, namespace, json.dumps(payload), _time.time()),
+    )
+    conn.commit()
+    conn.close()
+    return scan_id
+
+
+def _cache_pop(namespace, scan_id, ttl_seconds):
+    conn = _cache_conn()
+    row = conn.execute(
+        "SELECT data, ts FROM scan_cache WHERE scan_id = ? AND namespace = ?",
+        (scan_id, namespace),
+    ).fetchone()
+    if row:
+        conn.execute("DELETE FROM scan_cache WHERE scan_id = ?", (scan_id,))
+        conn.commit()
+    conn.close()
+    if not row:
+        return None
+    data, ts = row
+    if _time.time() - ts > ttl_seconds:
+        return None
+    return json.loads(data)
+
+
+def _cache_peek(namespace, scan_id, ttl_seconds):
+    conn = _cache_conn()
+    row = conn.execute(
+        "SELECT data, ts FROM scan_cache WHERE scan_id = ? AND namespace = ?",
+        (scan_id, namespace),
+    ).fetchone()
+    conn.close()
+    if not row:
+        return None
+    data, ts = row
+    if _time.time() - ts > ttl_seconds:
+        return None
+    return json.loads(data)
+
+
+def _cache_gc(namespace, ttl_seconds):
+    conn = _cache_conn()
+    conn.execute(
+        "DELETE FROM scan_cache WHERE namespace = ? AND ts < ?",
+        (namespace, _time.time() - ttl_seconds),
+    )
+    conn.commit()
+    conn.close()
+
+
